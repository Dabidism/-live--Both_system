# General Configuration
SECRET_KEY=secure_generated_secret_key_change_in_production
SYSTEM_TYPE=ENTRY # Options: ENTRY, EXIT

# Server Configuration
# Port will be auto-assigned: 5000 for ENTRY, 5001 for EXIT if not specified
# PORT=5000 

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=gate_pass_system

# Camera Configuration
# Entry Camera
CAMERA_URL_ENTRY=rtsp://admin:abcd1234@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1
# Exit Camera
CAMERA_URL_EXIT=rtsp://admin:abcd1234@192.168.1.108:554/cam/realmonitor?channel=2&subtype=1

# Performance Configuration
CAMERA_BUFFER_SIZE=1
CAMERA_FPS=15
SKIP_FRAMES=2
MAX_PROCESSING_WIDTH=640

# RFID Configuration (if applicable)
RFID_ENABLED=true